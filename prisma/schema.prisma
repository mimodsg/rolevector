generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  Draft
  Applied
  Interviewing
  Dropped
  Rejected
  Offer
}

enum UserRole {
  Authenticated
  Admin
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  passwordHash String               @map("password_hash")
  role         UserRole             @default(Authenticated)
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  masterCv     MasterCV?
  masterCvRevisions MasterCVRevision[]
  optimizedMasterCvs OptimizedMasterCV[]
  coverLetter  CoverLetterTemplate?
  applications Application[]
  aiUsage      AIUsage[]
  aiErrorLogs  AIErrorLog[]
  googleDriveConnection GoogleDriveConnection?

  @@map("users")
}

model GoogleDriveConnection {
  id                    String   @id @default(cuid())
  userId                String   @unique @map("user_id")
  googleEmail           String   @default("") @map("google_email")
  googleSubject         String   @default("") @map("google_subject")
  accessTokenEncrypted  String   @map("access_token_encrypted")
  refreshTokenEncrypted String?  @map("refresh_token_encrypted")
  scope                 String   @default("")
  tokenType             String   @default("") @map("token_type")
  expiresAt             DateTime? @map("expires_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("google_drive_connections")
}

model MasterCV {
  id                         String                   @id @default(cuid())
  userId                     String                   @unique @map("user_id")
  fullName                   String                   @map("full_name")
  title                      String                   @default("")
  email                      String
  phone                      String                   @default("")
  location                   String                   @default("")
  linkedin                   String                   @default("")
  website                    String                   @default("")
  summary                    String                   @default("")
  hardSkills                 String[]                 @default([]) @map("hard_skills")
  softSkills                 String[]                 @default([]) @map("soft_skills")
  technicalLanguages         String[]                 @default([]) @map("technical_languages")
  technicalFrameworks        String[]                 @default([]) @map("technical_frameworks")
  technicalCms               String[]                 @default([]) @map("technical_cms")
  technicalTools             String[]                 @default([]) @map("technical_tools")
  certifications             String[]                 @default([])
  languages                  String[]                 @default([])
  hiddenAdditionalExperience String[]                 @default([]) @map("hidden_additional_experience")
  hiddenKeywords             String[]                 @default([]) @map("hidden_keywords")
  workExperiences            MasterCVWorkExperience[]
  projects                   MasterCVProject[]
  educationEntries           MasterCVEducation[]
  optimizedVersions          OptimizedMasterCV[]
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  user                       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("master_cvs")
}

model OptimizedMasterCV {
  id                 String   @id @default(cuid())
  userId             String   @map("user_id")
  masterCvId         String   @map("master_cv_id")
  revisionNumber     Int      @default(1) @map("revision_number")
  isMain             Boolean  @default(false) @map("is_main")
  cvJson             Json     @map("cv_json")
  appliedSuggestionIds String[] @default([]) @map("applied_suggestion_ids")
  promotedAt         DateTime? @map("promoted_at")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterCv           MasterCV @relation(fields: [masterCvId], references: [id], onDelete: Cascade)

  @@index([userId, isMain])
  @@index([userId, createdAt])
  @@index([masterCvId, revisionNumber])
  @@map("optimized_master_cvs")
}

model MasterCVRevision {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  sourceMasterCvId String   @map("source_master_cv_id")
  revisionNumber   Int      @default(1) @map("revision_number")
  cvJson           Json     @map("cv_json")
  createdAt        DateTime @default(now()) @map("created_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, revisionNumber])
  @@map("master_cv_revisions")
}

model MasterCVWorkExperience {
  id                   String   @id @default(cuid())
  masterCvId           String   @map("master_cv_id")
  sortOrder            Int      @default(0) @map("sort_order")
  company              String
  title                String
  location             String   @default("")
  engagementType       String   @default("") @map("engagement_type")
  startDate            String   @default("") @map("start_date")
  endDate              String   @default("") @map("end_date")
  current              Boolean  @default(false)
  description          String   @default("")
  hardSkills           String[] @default([]) @map("hard_skills")
  softSkills           String[] @default([]) @map("soft_skills")
  programmingLanguages String[] @default([]) @map("programming_languages")
  frameworks           String[] @default([])
  cms                  String[] @default([])
  tools                String[] @default([])
  masterCv             MasterCV @relation(fields: [masterCvId], references: [id], onDelete: Cascade)

  @@index([masterCvId, sortOrder])
  @@map("master_cv_work_experiences")
}

model MasterCVProject {
  id          String   @id @default(cuid())
  masterCvId  String   @map("master_cv_id")
  sortOrder   Int      @default(0) @map("sort_order")
  title       String
  description String   @default("")
  client      String   @default("")
  masterCv    MasterCV @relation(fields: [masterCvId], references: [id], onDelete: Cascade)

  @@index([masterCvId, sortOrder])
  @@map("master_cv_projects")
}

model MasterCVEducation {
  id          String   @id @default(cuid())
  masterCvId  String   @map("master_cv_id")
  sortOrder   Int      @default(0) @map("sort_order")
  institution String
  degree      String   @default("")
  location    String   @default("")
  startDate   String   @default("") @map("start_date")
  endDate     String   @default("") @map("end_date")
  masterCv    MasterCV @relation(fields: [masterCvId], references: [id], onDelete: Cascade)

  @@index([masterCvId, sortOrder])
  @@map("master_cv_education")
}

model CoverLetterTemplate {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  content   String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cover_letter_templates")
}

model Application {
  id                String            @id @default(cuid())
  userId            String            @map("user_id")
  companyName       String?           @map("company_name")
  positionTitle     String?           @map("position_title")
  salary            String            @default("")
  location          String?
  jobApplicationUrl String            @default("") @map("job_application_url")
  companyUrl        String            @default("") @map("company_url")
  jobContext        String            @default("") @map("job_context")
  companyContext    String            @default("") @map("company_context")
  jobDetails        String            @map("job_details")
  parsedMetadata    Json              @map("parsed_metadata")
  optimizedCvJson   Json              @map("optimized_cv_json")
  optimizedCvText   String            @default("") @map("optimized_cv_text")
  coverLetterText   String            @map("cover_letter_text")
  baselineAtsScore  Float             @default(0) @map("baseline_ats_score")
  atsScore          Float             @map("ats_score")
  fitScore          Float             @default(0) @map("fit_score")
  fitAssessment     Json              @default("{}") @map("fit_assessment")
  analysisSnapshot  Json              @default("{}") @map("analysis_snapshot")
  optimizedAt       DateTime?         @map("optimized_at")
  status            ApplicationStatus @default(Draft)
  createdAt         DateTime          @default(now()) @map("created_at")
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiUsage           AIUsage[]
  aiErrorLogs       AIErrorLog[]

  @@index([userId, createdAt])
  @@index([status])
  @@map("applications")
}

model AIUsage {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  applicationId String?      @map("application_id")
  model         String
  inputTokens   Int          @default(0) @map("input_tokens")
  outputTokens  Int          @default(0) @map("output_tokens")
  estimatedCost Decimal      @default(0) @map("estimated_cost") @db.Decimal(10, 6)
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_usage")
}

model AIErrorLog {
  id            String       @id @default(cuid())
  userId        String       @map("user_id")
  applicationId String?      @map("application_id")
  model         String
  errorMessage  String       @map("error_message")
  retryCount    Int          @default(0) @map("retry_count")
  createdAt     DateTime     @default(now()) @map("created_at")
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("ai_error_logs")
}
